#version 450

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

#ifndef TILE_E
#define TILE_E 8
#endif

#ifdef USE_VEC4
#define ELEM_T uvec4
#define ZERO_ELEM uvec4(0u)
#else
#define ELEM_T uint
#define ZERO_ELEM 0u
#endif

layout(std430, set = 0, binding = 0) readonly buffer DataBuf {
  ELEM_T d[];
};

layout(std430, set = 0, binding = 1) readonly buffer DirectTab256Buf {
  uvec4 tab[];
};

layout(std430, set = 0, binding = 2) writeonly buffer OutBuf {
  ELEM_T out_syms[];
};

layout(push_constant) uniform DirectPush {
  uint rows;
  uint stride_units;
  uint num_esis;
  uint tile_offset;
  uint block_offset;
} pc;

uint xtime4(uint v) {
  uint hi = (v >> 7u) & 0x01010101u;
  return ((v & 0x7f7f7f7fu) << 1u) ^ (hi * 0x1du);
}

#ifdef USE_VEC4
uvec4 xtime_elem(uvec4 v) {
  return uvec4(xtime4(v.x), xtime4(v.y), xtime4(v.z), xtime4(v.w));
}
#else
uint xtime_elem(uint v) {
  return xtime4(v);
}
#endif

#define BUILD_NIB_TAB(t, base_val) \
  t[0] = ZERO_ELEM;                \
  t[1] = base_val;                 \
  t[2] = xtime_elem(t[1]);         \
  t[3] = t[2] ^ t[1];              \
  t[4] = xtime_elem(t[2]);         \
  t[5] = t[4] ^ t[1];              \
  t[6] = t[4] ^ t[2];              \
  t[7] = t[6] ^ t[1];              \
  t[8] = xtime_elem(t[4]);         \
  t[9] = t[8] ^ t[1];              \
  t[10] = t[8] ^ t[2];             \
  t[11] = t[10] ^ t[1];            \
  t[12] = t[8] ^ t[4];             \
  t[13] = t[12] ^ t[1];            \
  t[14] = t[12] ^ t[2];            \
  t[15] = t[14] ^ t[1];

#define ACCUM_NIB8(w, b0, b1, b2, b3, b4, b5, b6, b7) \
  if ((w) != 0u) {                                    \
    b0 ^= t[(w) & 0xfu];                              \
    b1 ^= t[((w) >> 4u) & 0xfu];                      \
    b2 ^= t[((w) >> 8u) & 0xfu];                      \
    b3 ^= t[((w) >> 12u) & 0xfu];                     \
    b4 ^= t[((w) >> 16u) & 0xfu];                     \
    b5 ^= t[((w) >> 20u) & 0xfu];                     \
    b6 ^= t[((w) >> 24u) & 0xfu];                     \
    b7 ^= t[(w) >> 28u];                              \
  }

void main() {
  uint unit_idx = gl_GlobalInvocationID.x;
  uint tile_idx = gl_WorkGroupID.y + pc.tile_offset;
  uint out_base = tile_idx * uint(TILE_E);
  uint block_idx = gl_WorkGroupID.z + pc.block_offset;

  if (unit_idx >= pc.stride_units || out_base >= pc.num_esis) {
    return;
  }

  uvec4 span = tab[tile_idx];
  uint block_base = block_idx * pc.rows * pc.stride_units + unit_idx;

  ELEM_T a0 = ZERO_ELEM, a1 = ZERO_ELEM, a2 = ZERO_ELEM, a3 = ZERO_ELEM;
  ELEM_T a4 = ZERO_ELEM, a5 = ZERO_ELEM, a6 = ZERO_ELEM, a7 = ZERO_ELEM;
#if TILE_E == 16
  ELEM_T a8 = ZERO_ELEM, a9 = ZERO_ELEM, a10 = ZERO_ELEM, a11 = ZERO_ELEM;
  ELEM_T a12 = ZERO_ELEM, a13 = ZERO_ELEM, a14 = ZERO_ELEM, a15 = ZERO_ELEM;

  for (uint k = span.x; k < span.y; k += 2u) {
    uvec4 cmd0 = tab[k];
    uvec4 cmd1 = tab[k + 1u];
    ELEM_T src = d[block_base + cmd0.x * pc.stride_units];
    ELEM_T t[16];
    BUILD_NIB_TAB(t, src)
    ACCUM_NIB8(cmd0.z, a0, a1, a2, a3, a4, a5, a6, a7)
    ACCUM_NIB8(cmd0.w, a8, a9, a10, a11, a12, a13, a14, a15)

    if ((cmd1.x | cmd1.y) != 0u) {
      ELEM_T hi_base = xtime_elem(t[8]);
      BUILD_NIB_TAB(t, hi_base)
      ACCUM_NIB8(cmd1.x, a0, a1, a2, a3, a4, a5, a6, a7)
      ACCUM_NIB8(cmd1.y, a8, a9, a10, a11, a12, a13, a14, a15)
    }
  }
#else
  for (uint k = span.x; k < span.y; k++) {
    uvec4 cmd = tab[k];
    ELEM_T src = d[block_base + cmd.x * pc.stride_units];
    ELEM_T t[16];
    BUILD_NIB_TAB(t, src)
    ACCUM_NIB8(cmd.y, a0, a1, a2, a3, a4, a5, a6, a7)

    if (cmd.z != 0u) {
      ELEM_T hi_base = xtime_elem(t[8]);
      BUILD_NIB_TAB(t, hi_base)
      ACCUM_NIB8(cmd.z, a0, a1, a2, a3, a4, a5, a6, a7)
    }
  }
#endif

  uint out_idx = (block_idx * pc.num_esis + out_base) * pc.stride_units + unit_idx;
  uint rem = pc.num_esis - out_base;
  out_syms[out_idx] = a0;
  if (rem > 1u) out_syms[out_idx + pc.stride_units] = a1;
  if (rem > 2u) out_syms[out_idx + 2u * pc.stride_units] = a2;
  if (rem > 3u) out_syms[out_idx + 3u * pc.stride_units] = a3;
  if (rem > 4u) out_syms[out_idx + 4u * pc.stride_units] = a4;
  if (rem > 5u) out_syms[out_idx + 5u * pc.stride_units] = a5;
  if (rem > 6u) out_syms[out_idx + 6u * pc.stride_units] = a6;
  if (rem > 7u) out_syms[out_idx + 7u * pc.stride_units] = a7;
#if TILE_E == 16
  if (rem > 8u) out_syms[out_idx + 8u * pc.stride_units] = a8;
  if (rem > 9u) out_syms[out_idx + 9u * pc.stride_units] = a9;
  if (rem > 10u) out_syms[out_idx + 10u * pc.stride_units] = a10;
  if (rem > 11u) out_syms[out_idx + 11u * pc.stride_units] = a11;
  if (rem > 12u) out_syms[out_idx + 12u * pc.stride_units] = a12;
  if (rem > 13u) out_syms[out_idx + 13u * pc.stride_units] = a13;
  if (rem > 14u) out_syms[out_idx + 14u * pc.stride_units] = a14;
  if (rem > 15u) out_syms[out_idx + 15u * pc.stride_units] = a15;
#endif
}
