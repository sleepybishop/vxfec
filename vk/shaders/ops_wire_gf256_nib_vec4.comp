#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

#ifndef TILE_E
#define TILE_E 8
#endif

#if TILE_E == 32
#define HDR_WORDS 5u
#elif TILE_E == 16
#define HDR_WORDS 3u
#else
#define HDR_WORDS 2u
#endif

layout(std430, set = 0, binding = 0) readonly buffer WireInBuf {
  uvec4 d[];
};

layout(std430, set = 0, binding = 1) readonly buffer WireTab256Buf {
  uvec4 tab[];
};

layout(std430, set = 0, binding = 2) writeonly buffer WireOutBuf {
  uvec4 out_syms[];
};

layout(push_constant) uniform WirePush {
  uint Z;
  uint stride_vecs;
  uint flags_tiles;
  uint tile_offset;
  uint block_offset;
} pc;

uint xtime4(uint v) {
  uint m = v & 0x80808080u;
  uint sh = (v << 1u) & 0xfefefefeu;
  uint poly = m - (m >> 7u);
  return sh ^ (poly & 0x1d1d1d1du);
}

uvec4 xtime_vec4(uvec4 v) {
  return uvec4(xtime4(v.x), xtime4(v.y), xtime4(v.z), xtime4(v.w));
}

#define BUILD_NIB_TAB(t, base_val) \
  t[0] = uvec4(0u);                \
  t[1] = (base_val);               \
  t[2] = xtime_vec4(t[1]);         \
  t[3] = t[2] ^ t[1];              \
  t[4] = xtime_vec4(t[2]);         \
  t[5] = t[4] ^ t[1];              \
  t[6] = t[4] ^ t[2];              \
  t[7] = t[6] ^ t[1];              \
  t[8] = xtime_vec4(t[4]);         \
  t[9] = t[8] ^ t[1];              \
  t[10] = t[8] ^ t[2];             \
  t[11] = t[10] ^ t[1];            \
  t[12] = t[8] ^ t[4];             \
  t[13] = t[12] ^ t[1];            \
  t[14] = t[12] ^ t[2];             \
  t[15] = t[14] ^ t[1];

#define ACCUM_NIB8(word_, b0, b1, b2, b3, b4, b5, b6, b7) \
  {                                                       \
    uint w_ = (word_);                                    \
    if ((w_ & 0xffffu) != 0u) {                           \
      b0 ^= t[w_ & 0xfu];                                 \
      b1 ^= t[(w_ >> 4u) & 0xfu];                         \
      b2 ^= t[(w_ >> 8u) & 0xfu];                         \
      b3 ^= t[(w_ >> 12u) & 0xfu];                        \
    }                                                     \
    if ((w_ >> 16u) != 0u) {                              \
      b4 ^= t[(w_ >> 16u) & 0xfu];                        \
      b5 ^= t[(w_ >> 20u) & 0xfu];                        \
      b6 ^= t[(w_ >> 24u) & 0xfu];                        \
      b7 ^= t[w_ >> 28u];                                 \
    }                                                     \
  }

#define ACCUM_GF2_8(src, word_, b0, b1, b2, b3, b4, b5, b6, b7) \
  {                                                             \
    uint w_ = (word_);                                          \
    if ((w_ & 0xffffu) != 0u) {                                 \
      if ((w_ & 0x00000001u) != 0u) b0 ^= (src);                \
      if ((w_ & 0x00000010u) != 0u) b1 ^= (src);                \
      if ((w_ & 0x00000100u) != 0u) b2 ^= (src);                \
      if ((w_ & 0x00001000u) != 0u) b3 ^= (src);                \
    }                                                           \
    if ((w_ >> 16u) != 0u) {                                    \
      if ((w_ & 0x00010000u) != 0u) b4 ^= (src);                \
      if ((w_ & 0x00100000u) != 0u) b5 ^= (src);                \
      if ((w_ & 0x01000000u) != 0u) b6 ^= (src);                \
      if ((w_ & 0x10000000u) != 0u) b7 ^= (src);                \
    }                                                           \
  }

uvec4 shift4_vec4(uvec4 v1) {
  uvec4 v2 = xtime_vec4(v1);
  uvec4 v4 = xtime_vec4(v2);
  return xtime_vec4(xtime_vec4(v4));
}

#define WRITE_WIRE_OUT(idx, val, oslot)               \
  if (tile_len > (idx)) {                             \
    out_syms[z_base + (oslot) * slot_stride] = (val); \
  }

void main() {
  uint vec_idx = gl_GlobalInvocationID.x;
  uint tile_idx = gl_WorkGroupID.y + pc.tile_offset;
  uint disp_z = gl_WorkGroupID.z + pc.block_offset;
  uint hdr_stride = pc.flags_tiles & 0x7fffffffu;
  bool uniform_tab = ((pc.flags_tiles & 0x80000000u) != 0u);

  if (vec_idx >= pc.stride_vecs || disp_z >= pc.Z || tile_idx >= hdr_stride) {
    return;
  }

  uint hdr_idx = uniform_tab ? tile_idx : (disp_z * hdr_stride + tile_idx);
  uint hdr_base = hdr_idx * HDR_WORDS;
  uvec4 h0 = tab[hdr_base];
  uint tile_len = h0.z;
  if (tile_len == 0u) {
    return;
  }

  uint block_idx = uniform_tab ? disp_z : h0.w;
  uint z_base = block_idx * pc.stride_vecs + vec_idx;
  uint slot_stride = pc.Z * pc.stride_vecs;

  uvec4 a0 = uvec4(0u), a1 = uvec4(0u), a2 = uvec4(0u), a3 = uvec4(0u);
  uvec4 a4 = uvec4(0u), a5 = uvec4(0u), a6 = uvec4(0u), a7 = uvec4(0u);
#if TILE_E >= 16
  uvec4 a8 = uvec4(0u), a9 = uvec4(0u), a10 = uvec4(0u), a11 = uvec4(0u);
  uvec4 a12 = uvec4(0u), a13 = uvec4(0u), a14 = uvec4(0u), a15 = uvec4(0u);
#endif
#if TILE_E == 32
  uvec4 a16 = uvec4(0u), a17 = uvec4(0u), a18 = uvec4(0u), a19 = uvec4(0u);
  uvec4 a20 = uvec4(0u), a21 = uvec4(0u), a22 = uvec4(0u), a23 = uvec4(0u);
  uvec4 a24 = uvec4(0u), a25 = uvec4(0u), a26 = uvec4(0u), a27 = uvec4(0u);
  uvec4 a28 = uvec4(0u), a29 = uvec4(0u), a30 = uvec4(0u), a31 = uvec4(0u);

  for (uint k = h0.x; k < h0.y; k += 3u) {
    uvec4 cmd0 = tab[k];
    uvec4 cmd1 = tab[k + 1u];
    uvec4 cmd2 = tab[k + 2u];
    uvec4 src = d[z_base + cmd0.x * slot_stride];
    uint lo_or = cmd0.y | cmd0.z | cmd0.w | cmd1.x;
    uint hi_or = cmd1.y | cmd1.z | cmd1.w | cmd2.x;
    if (((lo_or & 0xeeeeeeeeu) | hi_or) == 0u) {
      ACCUM_GF2_8(src, cmd0.y, a0, a1, a2, a3, a4, a5, a6, a7)
      ACCUM_GF2_8(src, cmd0.z, a8, a9, a10, a11, a12, a13, a14, a15)
      ACCUM_GF2_8(src, cmd0.w, a16, a17, a18, a19, a20, a21, a22, a23)
      ACCUM_GF2_8(src, cmd1.x, a24, a25, a26, a27, a28, a29, a30, a31)
    } else {
      uvec4 cur_base = src;
      [[dont_unroll]] for (uint hp = 0u; hp < 2u; hp++) {
        uint w0 = (hp == 0u) ? cmd0.y : cmd1.y;
        uint w1 = (hp == 0u) ? cmd0.z : cmd1.z;
        uint w2 = (hp == 0u) ? cmd0.w : cmd1.w;
        uint w3 = (hp == 0u) ? cmd1.x : cmd2.x;
        if ((w0 | w1 | w2 | w3) != 0u) {
          uvec4 t[16];
          BUILD_NIB_TAB(t, cur_base)
          ACCUM_NIB8(w0, a0, a1, a2, a3, a4, a5, a6, a7)
          ACCUM_NIB8(w1, a8, a9, a10, a11, a12, a13, a14, a15)
          ACCUM_NIB8(w2, a16, a17, a18, a19, a20, a21, a22, a23)
          ACCUM_NIB8(w3, a24, a25, a26, a27, a28, a29, a30, a31)
          if (hp == 0u && hi_or != 0u) {
            cur_base = xtime_vec4(t[8]);
          }
        } else if (hp == 0u) {
          cur_base = shift4_vec4(cur_base);
        }
      }
    }
  }
#elif TILE_E == 16
  for (uint k = h0.x; k < h0.y; k += 2u) {
    uvec4 cmd0 = tab[k];
    uvec4 cmd1 = tab[k + 1u];
    uvec4 src = d[z_base + cmd0.x * slot_stride];
    uint lo_or = cmd0.z | cmd0.w;
    uint hi_or = cmd1.x | cmd1.y;
    if (((lo_or & 0xeeeeeeeeu) | hi_or) == 0u) {
      ACCUM_GF2_8(src, cmd0.z, a0, a1, a2, a3, a4, a5, a6, a7)
      ACCUM_GF2_8(src, cmd0.w, a8, a9, a10, a11, a12, a13, a14, a15)
    } else {
      uvec4 t[16];
      uvec4 hi_base;
      if (lo_or != 0u) {
        BUILD_NIB_TAB(t, src)
        ACCUM_NIB8(cmd0.z, a0, a1, a2, a3, a4, a5, a6, a7)
        ACCUM_NIB8(cmd0.w, a8, a9, a10, a11, a12, a13, a14, a15)
        hi_base = xtime_vec4(t[8]);
      } else {
        hi_base = shift4_vec4(src);
      }
      if (hi_or != 0u) {
        BUILD_NIB_TAB(t, hi_base)
        ACCUM_NIB8(cmd1.x, a0, a1, a2, a3, a4, a5, a6, a7)
        ACCUM_NIB8(cmd1.y, a8, a9, a10, a11, a12, a13, a14, a15)
      }
    }
  }
#else
  for (uint k = h0.x; k < h0.y; k++) {
    uvec4 cmd = tab[k];
    uvec4 src = d[z_base + cmd.x * slot_stride];
    uint lo_or = cmd.y;
    uint hi_or = cmd.z;
    if (((lo_or & 0xeeeeeeeeu) | hi_or) == 0u) {
      ACCUM_GF2_8(src, cmd.y, a0, a1, a2, a3, a4, a5, a6, a7)
    } else {
      uvec4 t[16];
      uvec4 hi_base;
      if (lo_or != 0u) {
        BUILD_NIB_TAB(t, src)
        ACCUM_NIB8(cmd.y, a0, a1, a2, a3, a4, a5, a6, a7)
        hi_base = xtime_vec4(t[8]);
      } else {
        hi_base = shift4_vec4(src);
      }
      if (hi_or != 0u) {
        BUILD_NIB_TAB(t, hi_base)
        ACCUM_NIB8(cmd.z, a0, a1, a2, a3, a4, a5, a6, a7)
      }
    }
  }
#endif

  uvec4 os0 = tab[hdr_base + 1u];
  out_syms[z_base + (os0.x & 0xffffu) * slot_stride] = a0;
  WRITE_WIRE_OUT(1u, a1, os0.x >> 16u)
  WRITE_WIRE_OUT(2u, a2, os0.y & 0xffffu)
  WRITE_WIRE_OUT(3u, a3, os0.y >> 16u)
  WRITE_WIRE_OUT(4u, a4, os0.z & 0xffffu)
  WRITE_WIRE_OUT(5u, a5, os0.z >> 16u)
  WRITE_WIRE_OUT(6u, a6, os0.w & 0xffffu)
  WRITE_WIRE_OUT(7u, a7, os0.w >> 16u)
#if TILE_E >= 16
  uvec4 os1 = tab[hdr_base + 2u];
  WRITE_WIRE_OUT(8u, a8, os1.x & 0xffffu)
  WRITE_WIRE_OUT(9u, a9, os1.x >> 16u)
  WRITE_WIRE_OUT(10u, a10, os1.y & 0xffffu)
  WRITE_WIRE_OUT(11u, a11, os1.y >> 16u)
  WRITE_WIRE_OUT(12u, a12, os1.z & 0xffffu)
  WRITE_WIRE_OUT(13u, a13, os1.z >> 16u)
  WRITE_WIRE_OUT(14u, a14, os1.w & 0xffffu)
  WRITE_WIRE_OUT(15u, a15, os1.w >> 16u)
#endif
#if TILE_E == 32
  uvec4 os2 = tab[hdr_base + 3u];
  uvec4 os3 = tab[hdr_base + 4u];
  WRITE_WIRE_OUT(16u, a16, os2.x & 0xffffu)
  WRITE_WIRE_OUT(17u, a17, os2.x >> 16u)
  WRITE_WIRE_OUT(18u, a18, os2.y & 0xffffu)
  WRITE_WIRE_OUT(19u, a19, os2.y >> 16u)
  WRITE_WIRE_OUT(20u, a20, os2.z & 0xffffu)
  WRITE_WIRE_OUT(21u, a21, os2.z >> 16u)
  WRITE_WIRE_OUT(22u, a22, os2.w & 0xffffu)
  WRITE_WIRE_OUT(23u, a23, os2.w >> 16u)
  WRITE_WIRE_OUT(24u, a24, os3.x & 0xffffu)
  WRITE_WIRE_OUT(25u, a25, os3.x >> 16u)
  WRITE_WIRE_OUT(26u, a26, os3.y & 0xffffu)
  WRITE_WIRE_OUT(27u, a27, os3.y >> 16u)
  WRITE_WIRE_OUT(28u, a28, os3.z & 0xffffu)
  WRITE_WIRE_OUT(29u, a29, os3.z >> 16u)
  WRITE_WIRE_OUT(30u, a30, os3.w & 0xffffu)
  WRITE_WIRE_OUT(31u, a31, os3.w >> 16u)
#endif
}
